#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dev-only artifacts
/tool/apk_inspect/
/tool/*.png
/tool/*.xml
/tool/*.bin
/tool/*.sqlite
/tool/signed/
/tool/signedmanifest.json
/tool/signedpayloads/

# Ad-hoc debug artifacts dumped into the project root during dev sessions
# (debug screenshots, extracted DB dumps, temp-path leaks, working lists).
# These are NOT part of the project — kept locally only.
screenshot*.png
scr.png
app_v12.bin
app_v12.db
app.db
C*Users007AppDataLocalTempkilo*.bin
file_list.txt
.mcp.json.backup-*

# Self-signed TLS certs (regenerate locally via
# `tool/gen_cert.sh` which uses `tool/certs/openssl.cnf`).
/tool/certs/*.crt
/tool/certs/*.key
/tool/certs/*.pfx
/tool/certs/openssl.cnf

# Kilo IDE-specific (config may contain API keys, MCP paths)
.kilo/

